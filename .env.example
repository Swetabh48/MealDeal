# MealDeal environment template
# Copy to .env and fill in real values. Never commit .env.

# --- Required ---
MONGODB_URI=mongodb://127.0.0.1:27017/yelediet
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- AI (required for meal plans, swap, doctor chat, workouts, OCR) ---
GEMINI_API_KEY=

# --- Optional nutrition enrichment ---
# USDA_API_KEY=
# FDC_API_KEY=

# --- Optional Sunday email reminders ---
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=MealDeal <noreply@example.com>

# --- Optional design scripts only (not used by the running app) ---
# MANUS_API_KEY=
